# INACTIVE SOURCE TEMPLATE. Root must review and explicitly publish separately.
# LOCAL PROPOSAL: root must approve exact publication and the separate trust record.
# Eventual active copy must remain byte-identical to this inventoried template.
name: Reviewed isolated 15-case component stage
on:
  push:
    branches: [experiment/msys-component-stage-review]
permissions:
  contents: read
concurrency:
  group: combined-runtime-component-stage-${{ github.ref }}
  cancel-in-progress: false
jobs:
  rebuilt-component-stage:
    if: github.event_name == 'push' && github.ref == 'refs/heads/experiment/msys-component-stage-review'
    runs-on: windows-2025
    timeout-minutes: 120
    env:
      PYTHONIOENCODING: utf-8
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ github.sha }}
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065
        with:
          python-version: '3.14'
      - name: Create private build root
        shell: pwsh
        run: |
          $root = 'C:\stormtty-build-review'
          if (Test-Path $root) { throw 'New build root required' }
          New-Item -ItemType Directory "$root/evidence" | Out-Null
          "EXPERIMENT_ROOT=$root" | Out-File $env:GITHUB_ENV -Encoding utf8 -Append
          git rev-parse HEAD | Set-Content "$root/evidence/commit.txt"
          New-Item -ItemType Directory "$root/source" | Out-Null
          git archive --format=tar --output="$root/source.tar" HEAD
          if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
          tar -xf "$root/source.tar" -C "$root/source"
          if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
          Remove-Item -LiteralPath "$root/source.tar"
          [ordered]@{ repeat=1; run_id='${{ github.run_id }}'; run_attempt='${{ github.run_attempt }}'; commit='${{ github.sha }}'; clean_root=$true } | ConvertTo-Json | Set-Content "$root/evidence/independent-build.json"
      - name: Verify exact archived executable dependency bytes
        shell: python
        run: |
          import hashlib,pathlib
          root=pathlib.Path('C:/stormtty-build-review/source')
          expected={
              'tools/run-owned-process.py':'ba3dd67e0182005c3be478eef9ac2f4d0289b9287943d7b3fb37dbd76168d5d7',
              'tools/ci-msvc-env.ps1':'1f3c475a9c2e491bd6e15e341c3a7948f165c4e24d695e4b941787a2c39a49d0',
          }
          for name,pinned in expected.items():
              data=(root/name).read_bytes()
              actual=hashlib.sha256(data).hexdigest()
              crlf=data.count(b'\r\n')
              lone_lf=data.count(b'\n')-crlf
              print(f'{name}: sha256={actual} crlf={crlf} lone_lf={lone_lf}',flush=True)
              if actual!=pinned or crlf==0 or lone_lf!=0:
                  raise ValueError('archived dependency byte identity mismatch: '+name)
      - name: Initialize trusted native compiler
        shell: pwsh
        run: C:/stormtty-build-review/source/tools/ci-msvc-env.ps1
      - name: Compile controller without executing it
        shell: pwsh
        run: C:/stormtty-build-review/source/tools/probes/msys-runtime-experiment/combined-runtime/build-review/build-controller.ps1 -Output "$env:EXPERIMENT_ROOT/controller"
      - name: Fetch exact official source archive for build
        shell: python
        run: |
          import hashlib,os,pathlib,urllib.request
          root=pathlib.Path(os.environ['EXPERIMENT_ROOT'])
          path=root/'msys2-runtime-3.6.11-4.src.tar.zst'
          url='https://repo.msys2.org/msys/sources/'+path.name
          with urllib.request.urlopen(url,timeout=60) as response,path.open('xb') as output:
              size=0
              while chunk:=response.read(1024*1024):
                  size+=len(chunk)
                  if size>128907415:raise ValueError('source size bound')
                  output.write(chunk)
          with path.open('rb') as stream:digest=hashlib.file_digest(stream,'sha256').hexdigest()
          assert path.stat().st_size==128907415 and digest=='4b178dfb5b77bce293706dcfabea673b77d8da061a4725bdf4cd94f17533c204'
          (root/'evidence/source-identity.txt').write_text(url+'\n'+digest+'\n')
      - uses: msys2/setup-msys2@ec48f7c5447b3140e2b088413ae3a55687bccb6e
        with:
          msystem: MSYS
          location: C:/stormtty-msys-build-tools
          update: true
          cache: false
          path-type: minimal
          install: >-
            base-devel autotools cocom docbook-xsl gcc gettext-devel git
            libzstd-devel libiconv-devel mingw-w64-cross-crt mingw-w64-cross-gcc
            mingw-w64-cross-zlib perl python xmlto zlib-devel zstd texinfo
      - name: Verify unchanged private GCC15 package toolchain
        shell: msys2 {0}
        run: |
          set -euo pipefail
          cd /c/stormtty-build-review/source
          root=$(cygpath -u "$EXPERIMENT_ROOT")
          bash tools/probes/msys-runtime-experiment/toolchain.sh "$root/gcc15" 2>&1 | tee "$root/evidence/gcc15-preflight.log"
      - name: Build copied variant only
        id: copied
        timeout-minutes: 40
        shell: msys2 {0}
        run: |
          set -euo pipefail
          cd /c/stormtty-build-review/source
          root=$(cygpath -u "$EXPERIMENT_ROOT")
          export EXPERIMENT_TOOLCHAIN="$root/gcc15"
          bash tools/probes/msys-runtime-experiment/combined-runtime/build-review/build.sh "$root/msys2-runtime-3.6.11-4.src.tar.zst" "$root/copied-build" copied 2>&1 | tee "$root/evidence/copied-build.log"
      - name: Build combined variant with identical toolchain
        if: steps.copied.outcome == 'success'
        timeout-minutes: 40
        shell: msys2 {0}
        run: |
          set -euo pipefail
          cd /c/stormtty-build-review/source
          root=$(cygpath -u "$EXPERIMENT_ROOT")
          export EXPERIMENT_TOOLCHAIN="$root/gcc15"
          bash tools/probes/msys-runtime-experiment/combined-runtime/build-review/build.sh "$root/msys2-runtime-3.6.11-4.src.tar.zst" "$root/combined-build" combined 2>&1 | tee "$root/evidence/combined-build.log"
          cmp "$root/copied-build/provenance/pacman-before.txt" "$root/combined-build/provenance/pacman-before.txt"
          cmp "$root/copied-build/provenance/compiler-packages.txt" "$root/combined-build/provenance/compiler-packages.txt"
      - name: Collect bounded text evidence, including failed builds
        if: always()
        shell: pwsh
        run: |
          python C:/stormtty-build-review/source/tools/probes/msys-runtime-experiment/combined-runtime/build-review/collect.py "$env:EXPERIMENT_ROOT" "$env:EXPERIMENT_ROOT/cold-stage-text"
          if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
      - name: Verify exact rebuild and authorization before the isolated component stage
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'
          $env:REVIEW_SHA256 = (Get-Content -LiteralPath C:/stormtty-build-review/source/tools/probes/msys-runtime-stage-trust/authorized-review.sha256 -Raw).Trim()
          python C:/stormtty-build-review/source/tools/probes/msys-runtime-experiment/combined-runtime/build-review/component-stage.py --build-root "$env:EXPERIMENT_ROOT" --cold-collection "$env:EXPERIMENT_ROOT/cold-stage-text" --review C:/stormtty-build-review/source/tools/probes/msys-runtime-stage-trust/authorized-review.json --review-sha256 "$env:REVIEW_SHA256" --output "$env:EXPERIMENT_ROOT/component-stage"
          # Preserve all statuses, including 2 = INCONCLUSIVE/full matrix pending.
          # No retry, continue-on-error, or conversion of pending coverage to success.
          exit $LASTEXITCODE
      - name: Collect bounded decoded component text after cleanup
        id: component_text
        if: always()
        shell: pwsh
        run: |
          if (Test-Path -LiteralPath "$env:EXPERIMENT_ROOT/component-stage") {
            python C:/stormtty-build-review/source/tools/probes/msys-runtime-experiment/combined-runtime/build-review/component-text.py "$env:EXPERIMENT_ROOT/component-stage" "$env:RUNNER_TEMP/component-stage-text"
            if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
            "present=true" | Out-File $env:GITHUB_OUTPUT -Encoding utf8 -Append
          }
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        if: always()
        with:
          name: component-stage-cold-text-${{ github.sha }}
          path: C:/stormtty-build-review/cold-stage-text/
          if-no-files-found: error
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        if: always() && steps.component_text.outputs.present == 'true'
        with:
          name: component-stage-decoded-text-${{ github.sha }}
          path: ${{ runner.temp }}/component-stage-text/
          if-no-files-found: error
# No default changes, app smoke, full-matrix claim, automatic promotion, binary or
# raw trace upload. Only the explicitly gated 15-case component stage is proposed.
