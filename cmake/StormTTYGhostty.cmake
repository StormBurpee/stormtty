include_guard(GLOBAL)

# Build separately with tools/bootstrap.py. Never mutate an upstream checkout
# from CMake, fetch moving branches, or run an unbounded nested compiler job.
set(STORMTTY_GHOSTTY_ROOT "" CACHE PATH "Pinned libghostty-vt bootstrap install prefix")
set(STORMTTY_GHOSTTY_LINKAGE "SHARED" CACHE STRING "Ghostty linkage: SHARED or STATIC")
set_property(CACHE STORMTTY_GHOSTTY_LINKAGE PROPERTY STRINGS SHARED STATIC)

function(stormtty_import_ghostty)
    if(TARGET stormtty::ghostty)
        return()
    endif()
    if(NOT STORMTTY_GHOSTTY_ROOT)
        message(FATAL_ERROR "Run tools/bootstrap.py, then set STORMTTY_GHOSTTY_ROOT to its install prefix")
    endif()
    get_filename_component(_root "${STORMTTY_GHOSTTY_ROOT}" ABSOLUTE)
    if(NOT EXISTS "${_root}/include/ghostty/vt.h")
        message(FATAL_ERROR "Missing Ghostty public C header under ${_root}; run tools/bootstrap.py")
    endif()
    if(NOT EXISTS "${_root}/stormtty-build.json")
        message(FATAL_ERROR "Missing pinned bootstrap metadata: ${_root}/stormtty-build.json")
    endif()
    file(READ "${_root}/stormtty-build.json" _metadata)
    string(JSON _commit GET "${_metadata}" ghostty_commit)
    string(JSON _zig GET "${_metadata}" zig_version)
    string(JSON _target GET "${_metadata}" target)
    if(NOT _commit STREQUAL "46e9dc9a927b2e7e7cba79e6902c176127dbdf2c" OR NOT _zig STREQUAL "0.17.0")
        message(FATAL_ERROR "Ghostty source/toolchain pin mismatch; rebuild with tools/bootstrap.py")
    endif()
    if(WIN32)
        if(NOT _target MATCHES "-windows-")
            message(FATAL_ERROR "Non-Windows Ghostty artifact cannot be linked into Windows")
        endif()
        if(MSVC AND NOT _target MATCHES "-windows-msvc$")
            message(FATAL_ERROR "MSVC requires a native MSVC Ghostty build, not a Windows GNU cross artifact")
        elseif(MINGW AND NOT _target MATCHES "-windows-gnu$")
            message(FATAL_ERROR "MinGW requires a Windows GNU Ghostty build")
        endif()
    elseif(APPLE AND NOT _target MATCHES "-macos")
        message(FATAL_ERROR "macOS requires a macOS Ghostty artifact")
    elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND NOT _target MATCHES "-linux-")
        message(FATAL_ERROR "Linux requires a Linux Ghostty artifact")
    endif()

    if(STORMTTY_GHOSTTY_LINKAGE STREQUAL "SHARED")
        add_library(stormtty_ghostty SHARED IMPORTED GLOBAL)
        if(WIN32)
            set(_library "${_root}/bin/ghostty-vt.dll")
            set(_implib "${_root}/lib/ghostty-vt.lib")
            set_target_properties(stormtty_ghostty PROPERTIES IMPORTED_IMPLIB "${_implib}")
            if(NOT EXISTS "${_implib}")
                message(FATAL_ERROR "Missing Ghostty DLL import library: ${_implib}")
            endif()
        elseif(APPLE)
            set(_library "${_root}/lib/libghostty-vt.0.1.0.dylib")
        else()
            set(_library "${_root}/lib/libghostty-vt.so.0.1.0")
        endif()
    elseif(STORMTTY_GHOSTTY_LINKAGE STREQUAL "STATIC")
        add_library(stormtty_ghostty STATIC IMPORTED GLOBAL)
        if(WIN32)
            set(_library "${_root}/lib/ghostty-vt-static.lib")
            set_target_properties(stormtty_ghostty PROPERTIES INTERFACE_LINK_LIBRARIES "ntdll;kernel32")
        else()
            set(_library "${_root}/lib/libghostty-vt.a")
        endif()
        set_target_properties(stormtty_ghostty PROPERTIES INTERFACE_COMPILE_DEFINITIONS GHOSTTY_STATIC)
    else()
        message(FATAL_ERROR "STORMTTY_GHOSTTY_LINKAGE must be SHARED or STATIC")
    endif()
    if(NOT EXISTS "${_library}")
        message(FATAL_ERROR "Missing Ghostty artifact: ${_library}")
    endif()
    set_target_properties(stormtty_ghostty PROPERTIES
        IMPORTED_LOCATION "${_library}"
        INTERFACE_INCLUDE_DIRECTORIES "${_root}/include")
    add_library(stormtty::ghostty ALIAS stormtty_ghostty)
    message(STATUS "Ghostty ${_commit}, Zig ${_zig}, ${_target}, ${STORMTTY_GHOSTTY_LINKAGE}")
endfunction()

# Call for each Windows executable that loads the shared engine. Static linking
# does not need a runtime copy. Distribution packaging must also retain notices.
function(stormtty_copy_ghostty_runtime target)
    if(WIN32 AND STORMTTY_GHOSTTY_LINKAGE STREQUAL "SHARED")
        add_custom_command(TARGET ${target} POST_BUILD
            COMMAND ${CMAKE_COMMAND} -E copy_if_different
                "$<TARGET_FILE:stormtty_ghostty>" "$<TARGET_FILE_DIR:${target}>"
            VERBATIM)
    endif()
endfunction()
